{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Train: run F (most stable)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["train", "--run", "F"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Train: run A (baseline)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["train", "--run", "A"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Train: quick smoke run",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["train", "--run", "F", "--total-timesteps", "5000", "--learning-starts", "1000", "--buffer-size", "10000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Play: trained model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["play", "${input:checkpoint}", "--episodes", "5", "--video", "outputs/eval_videos"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Theory: grid-world value iteration",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["theory"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "checkpoint",
      "type": "promptString",
      "description": "Path to a model checkpoint",
      "default": "runs/<run_name>/model.pt"
    }
  ]
}
